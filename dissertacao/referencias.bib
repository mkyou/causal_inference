@article{liu_improved_2014,
	title = {Improved {Real}-time {Denoising} {Method} {Based} on {Lifting} {Wavelet} {Transform}},
	volume = {14},
	copyright = {http://creativecommons.org/licenses/by-nc-nd/3.0/},
